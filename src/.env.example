# Copy this file to src/.env. Never commit the real file.
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# Use at least 32 random characters in production.
SESSION_SECRET=replace-this-with-at-least-32-random-characters
SESSION_HOURS=8
COOKIE_SECURE=false
TRUST_PROXY=false

# Demo users are never created unless this is explicitly true.
DEMO_MODE=true

SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NoteVerse <noreply@noteverse.local>

MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_UPLOAD=8
